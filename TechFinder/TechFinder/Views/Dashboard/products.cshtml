@model IEnumerable<TechFinder.Models.Product>
@{
    ViewData["Title"] = "products";
}
<script>
    function confirmDelete(ProductId) {
        if (confirm('Are you sure you want to delete this product?')) {
            document.getElementById('deleteForm-' + ProductId).submit();
        }
    }
</script>
<div class="createbutton">
    <a asp-action="productadd" class="btn custom-btn-add btn-sm"><i class="fa-solid fa-add"></i> Create New Product</a>
</div>
<div class="tableContanier">
    <table class="information-table-list table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@Url.Content("~/image/" + item.MainImage)" style="width:50px; height:auto;" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td class="btn-col">
                        <a asp-action="productDetails" asp-route-id="@item.ProductId" class="btn custom-btn-details btn-sm"><i class="fa-solid fa-copy"></i> Details</a>
                        <a asp-action="productUpdate" asp-route-id="@item.ProductId" class="btn custom-btn-update btn-sm"><i class="fa-solid fa-pen-to-square"></i> Update</a>
                        <form id="deleteForm-@item.ProductId"
                    asp-action="ProductDelete"
                    asp-route-id="@item.ProductId"
                    method="post"
                    style="display: inline;">
                            @Html.AntiForgeryToken()
                            <a onclick="confirmDelete(@item.ProductId)" class="btn custom-btn-del btn-sm">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        </form>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>