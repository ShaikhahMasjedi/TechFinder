@{
    ViewData["Title"] = "Search Result";
}
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@section Styles {

  <style>

         *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            text-decoration: none;
            border: none;
            font-family:Arial, sans-serif; 
            direction: ltr;
        }
        body{
            background-color: #eee;
        }
        .no-results-message {
            margin-top: 50px;
            padding: 30px;
            background-color: #f8f9fa;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .no-results-message i {
            color:  #001F3F; 
        }

        .no-results-message h3 {
            font-size: 28px;
            color: #333;
            font-weight: bold;
            margin-top: 15px;
        }
    
        
        .no-results-message p {
            color: #6c757d;
            font-size: 18px;
            margin-top: 10px;
        }

        .btn-primary {
            padding: 10px 30px;
            font-size: 18px;
            border-radius: 50px;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

      
        .row {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh; 
        }

        .conta {
            margin-top: 20px;
             text-align:center;
        }




  </style>
}
@{
    ViewData["Title"] = "Search Result";
}
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="conta">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-6 text-center">
            <h2>@ViewData["Title"]</h2>

            <div class="no-results-message">
                <i class="fa fa-search fa-3x text-primary"></i>
                <h3 class="mt-3">No Results Found</h3>
                <p class="text-muted">@ViewBag.Message</p>
            </div>
        </div>
    </div>
</div>

