@{
    ViewData["Title"] = "Reset Password";
}

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger text-center" role="alert">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}


    @if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}
<div class="cart">

    <div class="title-cart unique">
        <p class="title">New Password</p>
        <div>
            <p>Enter new password</p>

        </div>
    </div>

    <form asp-action="ResetPassword" method="post" class="form1">
        <input type="password" name="newPassword" placeholder="new password" class="new-pass" id="password" autofocus required />
        <label for="password" class="fa f1 fa-lock"></label>

        <input type="password" name="confirmPassword" placeholder="confirm password" class="confirm-pass" id="confirm-pass" required />
        <label for="confirm-pass" class="fa f2 fa-lock"></label>

        <input type="hidden" name="email" value="@ViewBag.Email" />

       <button type="submit" class="btn btn-custom btn-sm">Change</button>
    </form>
</div>

@section Scripts {

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            text-decoration: none !important;
            border: none;
            font-family: Arial, sans-serif;
            direction: ltr;
        }

        body {
            background-color: #eee;
        }

        .cart{
            width: 40%;
            margin:3% auto;
            background-color: #fff;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            box-shadow: 0 14px 28px rgba(0,0,0,0.25), 
            0 10px 10px rgba(0,0,0,0.22);
            margin-bottom: 3.5%;
            margin-top:120px;
        }
        .title-cart{
            width: 80%;
            height: 100px;
            margin: auto;
            margin-top: 20px;
        }
        .unique{
            height: 130px;
        }
        .title-cart p{
            font-size: 17px;
            text-align: center;
            color: #3A6D8C ;
        }
        .title-cart .title{
            font-size: 30px;
            color:#001F3F;
            margin-bottom: 30px;
        }


        .cart form {
            display: flex;
            flex-direction: column;
            width: 50%;
            position: relative;
        }
        .cart input:focus {
            outline: 1px solid #001F3F;
        }

        .cart form input {
            margin: 10px 0;
            padding: 10px 40px;
            border-radius: 5px;
            box-shadow: .5px 2.5px 4.5px #001F3F;
            background-color: white;
            font-size: 18px;
            border: 1px solid #ccc;
            color: #001F3F;
            box-sizing: border-box;
        }
        .cart input::placeholder {
            font-size: 1rem;
            color: #001F3F;
        }
        .cart .fa::before {
            position: absolute;
            left: 3%;
            font-size: 21px;
            color: #001F3F;
        }
        .f1::before{
            top: 11%;
        }
        .f2::before{
            top:45%;
        }
        .fa-envelope::before{
            top: 16.5%;
        }

        .fa-unlock::before{
            top: 16.5%;
        }
        .chang-button,
        .continue-button {
            width: 40%;
            margin: 15px auto;
            text-align: center;
            font-size: 20px;
            border-radius: 15px;
            border: none;
            padding: 5px;
            cursor: pointer;
            background-color: #3A6D8C;
            color: white;
        }
        .chang-button:hover,
        .continue-button:hover{
            background-color: #6A9AB0; 
        }
        .btn-custom {
            font-size: 20px;
            border-radius: 15px;
            border: none;
            background-color: #3A6D8C;
            padding: 5px;
            color: white;
            width: 40%;
            margin: 15px auto;
            text-align: center;
            outline: none;

        }

        .btn-custom:hover {
            color: white;
            background-color: #6A9AB0;
        }
        .btn-custom:focus {
        outline: none; 
        box-shadow: none; 
    }
        .link{
            color: white;
        }


    </style>
}