@{
    ViewData["Title"] = "Payment";
}
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@section Styles {
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
      *{
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        text-decoration: none;
        border: none;
        font-family:Arial, sans-serif; 
        direction: ltr;
    }


    body{
        background-color: #eee;
    }
    .payment-page {
        font-family: Arial, sans-serif;
        background-color: #eee;
        color: #001F3F;
        font-size: 20px;
        background-color: #fff;
        padding: 5px 20px 15px 20px;
        border: 2px solid #ccc;
        border-radius: 6px;
        margin:50px 90px;
        height:1170px;
        margin-top:120px;
         margin-bottom: 5.5rem;
    }

    .payment-page h1 {
        text-transform: uppercase;
        background-color: #3A6D8C;
        color: #001F3F;
        text-align: center;
        border: 3px solid #001F3F;
        border-radius: 3px;
        margin-top: 10px;
    }

    .payment-page h2 {
        margin-top: 20px;
        margin-bottom: 15px;
        border-bottom: solid 2px #EAD8B1;
        text-align: center;
    }

    .payment-page p {
        margin-top: 10px;
    }

    .payment-page .container4 {
        background-color: #fff;
        padding: 5px 20px 15px 20px;
      
        border-radius: 6px;
        margin:70px 90px;
    }
   .payment-page   select{
    cursor: pointer;
}

  .payment-page fieldset{
    background-color: #fff;
    border: 1px solid #cfcfcf;
    border-radius: 4px;

   }
 
    .payment-page input[type="text"],
    .payment-page input[type="email"],
    .payment-page input[type="number"],
    .payment-page input[type="password"],
    .payment-page input[type="date"],
    .payment-page input[type="tel"],
    .payment-page select,
    .payment-page textarea {
          width: 100%;
        padding: 12px;
        border: 1px solid #cfcfcf;
        margin: 6px;
        border-radius: 5px;
        font-size: 18px;
        box-sizing: border-box; 
    }

    .btn-custom-pay {
        background-color: #3A6D8C;
        color: white;
        padding: 12px 30px;
        border: none;
        border-radius: 4px;
        font-size: 20px;
        text-align: center;
        margin-top: 3.6rem;
        width:810px;
        transition: background-color 0.3s ease;
        outline: none; 
    }

    .btn-custom-pay:hover {
        color: white;
        background-color: #6A9AB0;
    }
      .btn-custom-pay:focus {
        outline: none; 
        box-shadow: none; 
    }

        .btn-custom-Gback {
        background-color: #3A6D8C;
        color: white;
        padding: 12px 30px;
        border: none;
        border-radius: 4px;
        font-size: 20px;
        text-align: center;
        margin-top: 3rem;
        width:180px;
        transition: background-color 0.3s ease;
        outline: none; 
    }

    .btn-custom-Gback:hover {
        color: white;
        background-color: #6A9AB0;
    }
      .btn-custom-Gback:focus {
        outline: none; 
        box-shadow: none; 
    }

     .payment-page .finishtitle {
      position: absolute;
      top: 15%;
      left: 50%;
      transform: translateX(-50%);
      letter-spacing: 2px;
      word-spacing: -5px;
  
    }
    

     .payment-page .container2 {
      width: 50rem;
      height: 31rem;
      background-color: white;
      border-radius: 5%;
      position: relative;
      border: 1px solid #7C7C7C;
      box-shadow: 10px 10px 10px black;
      margin-top: 10px;
      margin-bottom: 40px;
    }

     .payment-page .heading {
        position: absolute;
        top: 10%;
        left: 50%;
        transform: translate(-50%,-0);  
        width: 100%;
        text-align: center;
        font-weight: bold;
        font-size: 2rem;
        text-transform: uppercase;
        letter-spacing: .5rem;
  
        background: white;
    }

     .payment-page .heading::after {
      content: '';
      background: black;
      border-bottom: 2px solid #EAD8B1;
      position: absolute;
      bottom: -15%;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
    }
    .wrapper {
      font-size: 3rem;
      background-color: #fff;
      padding: 5px 20px 15px 20px;
      border-radius: 6px;
      margin: 0 70px 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;

   
    }
     .payment-page .choose {
      margin-top: 6.5rem;
  
      display: flex;
      justify-content: space-around;
      align-items: center;
  
    }

    .payment-page .choose label {
      cursor: pointer;
      width: 50%;
      height: 100%;
    }


    .payment-page .choose img {
      width: 80%;
      height: 80%;
      margin: 5px 15px;
    }

    .payment-page .choose input[type="radio"] {
        width: 20px;
        height: 20px;
      }

  .payment-page .line {
      background: #001F3F;
      bottom: 0;
      width: 100%;
    }

  .payform {
       display: grid;
      grid-template-columns: 1fr  repeat(2, 40%) 1fr;
      grid-template-rows: 1fr 1fr 1fr 1fr;
      margin-top: .7rem;
      row-gap: .4rem;
      column-gap: 1rem;
    }
    .fas {
    margin-right: 5px; 

   }

    .accname {
      grid-column: 2/4;
      grid-row: 1/2;
    }
    .cardnumber {
      grid-column: 2/4;
      grid-row: 2/3;
    }

    .cvv {
      grid-column: 2/4;
      grid-row: 3/4;
    }
    .Exp_Date{
        grid-column: 2/4;
        grid-row: 4/5;
    }
    .Card_Type{
        grid-column: 2/4;
        grid-row: 5/6;
    }
    .Exp_Date::before{
      content: "Expiration";
      position: absolute;
      left: 205px;
      color: #aaa;
 
    }

    .Exp_Date input:focus+::before{
        display:none;
      }

    .choose div {
      width: 22%;
      height: 5rem;
      display: flex;
      align-items: center;
      justify-content: center;*
      padding-bottom: 4px;
      cursor: pointer;
    }

    #popupMessage {
    font-size: 1.5rem;
    background-color: #003366;
    color: white;
    padding: 20px 30px;
    border-radius: 10px;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1000;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    text-align: center;}

  </style>
}

@model TechFinder.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Payment";
}

<div class="container4 payment-page">
    <form asp-action="Payment" method="post">
        <h1>Payment</h1>
        <p>Required fields are followed by *</p>

        <h2>Contact Information</h2>
        <p>
            Phone No: *
            <input asp-for="PhoneNumber" type="tel" placeholder="+967 700972185" required />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </p>

        <p>
            Address: *
            <textarea asp-for="ShippingAddress" placeholder="Enter Your Address" cols="40" rows="5" required></textarea>
            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
        </p>

        <div class="wrapper">
            <div class="container2">
                <div class="heading">Payment Information</div>

                <div class="choose">
                    <div id="active" class="visa active">
                        <input asp-for="PaymentMethod" type="radio" value="MasterCard" required />
                        <label for="visa"><img src="~/image/master.png" alt="Master" /></label>
                    </div>
                    <div class="maestro">
                        <input asp-for="PaymentMethod" type="radio" value="Visa Card" />
                        <label for="maestro"><img src="~/image/Visa.png" alt="Visa" /></label>
                    </div>
                    <div class="paypal">
                        <input asp-for="PaymentMethod" type="radio" value="PayPal" />
                        <label for="paypal"><img src="~/image/paypal.png" alt="PayPal" /></label>
                    </div>
                </div>

                <div class="payform">
                    <input asp-for="AccountHolder" class="accname" placeholder="Account Holder Name*" required />
                    <span asp-validation-for="AccountHolder" class="text-danger"></span>

                    <input asp-for="CardNumber" class="cardnumber" placeholder="Credit Card Number*" required />
                    <span asp-validation-for="CardNumber" class="text-danger"></span>

                    <input asp-for="CVV" class="cvv" placeholder="CVV/CVV2*" required />
                    <span asp-validation-for="CVV" class="text-danger"></span>

                    <input asp-for="ExpiryDate" type="date" class="Exp_Date" required />
                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>


                </div>

                <button type="submit" class="btn btn-custom-pay btn-sm">Pay Now</button>


            </div>
        </div>
    </form>
        <button type="button" class="btn btn-custom-Gback" onclick="location.href='@Url.Action("ViewCart", "ShoppingCart")'">
            <i class="fas fa-arrow-left"></i> Go back
        </button>



    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                showConfirmButton: true
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: '@TempData["ErrorMessage"]',
                showConfirmButton: true
            });
        </script>
    }
</div>

@section Scripts {
    <script>
        document.getElementById("expiryDate").addEventListener("change", function () {
    var dateValue = this.value; 
    var parts = dateValue.split("-"); 
        if (parts.length === 3) {
            var formattedDate = parts[1] + "/" + parts[2] + "/" + parts[0];
            console.log("Formatted Date: " + formattedDate);
        }
    });

    </script>
    <partial name="_ValidationScriptsPartial" />
}



