@model IEnumerable<TechFinder.Models.User>
@{
    ViewData["Title"] = "customers";
}
<script>
    function confirmDelete(userId) {
        if (confirm('Are you sure you want to delete this customer?')) {
            document.getElementById('deleteForm-' + userId).submit();
        }
    }
</script>
<div class="createbutton">
    <a asp-action="customeradd" class="btn custom-btn-add btn-sm"><i class="fa-solid fa-add"></i> Create New Customer</a>
</div>
<div class="tableContanier">
    <table class="information-table-list table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Signup date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                if (item.UserType == "Customer")
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        <td class="btn-col">
                            <a asp-action="customerDetails" asp-route-id="@item.UserId" class="btn custom-btn-details btn-sm"><i class="fa-solid fa-copy"></i> Details</a>
                            <a asp-action="customerUpdate" asp-route-id="@item.UserId" class="btn custom-btn-update btn-sm"><i class="fa-solid fa-pen-to-square"></i> Update</a>
                            <form id="deleteForm-@item.UserId" asp-action="DeleteCustomer" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@item.UserId" />
                                <a class="btn custom-btn-del btn-sm" onclick="confirmDelete(@item.UserId)"><i class="fa-solid fa-trash"></i> Delete</a>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>