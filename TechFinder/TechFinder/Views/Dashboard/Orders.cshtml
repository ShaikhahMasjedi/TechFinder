@model TechFinder.ViewModels.OrdersViewModel
@{
    ViewData["Title"] = "Orders";
}
<div class="tableContanier">
    <table class="information-table-list table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Total Price</th>
                <th>Date</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Orders)
            {
                <tr>
                    <td>@Model.Users.FirstOrDefault(x => x.UserId == item.UserId)?.FullName</td>
                    <td>@item.TotalAmount</td>
                    <td>@item.CreatedAt.ToShortDateString()</td>
                    <td>@item.ShippingAddress</td>
                    <td>@item.Phone</td>
                    <td class="btn-col">
                        <a asp-action="OrderDetails" asp-route-id="@item.OrderId" class="btn custom-btn-details btn-sm"><i class="fa-solid fa-copy"></i> Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>