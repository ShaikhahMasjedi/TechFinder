@model TechFinder.ViewModels.OrderDetailsViewModel

<div class="det" >
    <div class="tableContanier" >
    <div>
        <h1>@Model.Order.User?.FullName</h1>

    </div>
        <table class="information-table-list table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>
                        <img src="@Url.Content("~/image/" + item.Product?.MainImage)" 
                                style="width:50px; height:auto;" />
                    </td>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Product?.Price.ToString()</td>

                </tr>
            }
        </tbody>
    </table>
        <h2 style="color:#6A9AB0; font-size:20px; text-align:right; margin-right:40px;">Total price : @Model.Order.TotalAmount.ToString()</h2>
</div>
    <button class="btn custom-btn-back btn-sm"><a asp-action="Orders">Go Back</a></button>
</div>

@section Scripts {
    <style>
        .det {
            background-color: #fff;
            padding: 50px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 96%;
            border: #6A9AB0 solid 1px;
            margin-left: 25px;
            margin-top:30px
        }
    </style>
}