@model IEnumerable<TechFinder.Models.ShoppingCart>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}



<div class="hh">
    <div class="container-rr">
        @if (Model != null && Model.Any()) // شرط وجود منتجات
        {
            <table>
                <heade class="headera">
                    <h6 class="ss">Your Shopping Cart <i class="fas fa-shopping-cart"></i></h6>
               </heade>

                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Unit Price</th>
                        <th>Quantity</th>
                        <th>Total Price</th>
                        <th>Action</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="small-column">
                                <img src="~/image/@item.Product.MainImage" alt="@item.Product.Name" />
                            </td>
                            <td>@item.Product.Name</td>
                            <td>@item.Product.Price</td>
                            <td>
                                <div class="quantity-control">
                                    <a asp-action="AddToQuantity" asp-route-id="@item.CartId" class="quantity-add-sub">+</a>
                                    <span>@item.Quantity</span>
                                    <a asp-action="subToQuantity" asp-route-id="@item.CartId" class="quantity-add-sub">-</a>
                                </div>
                            </td>
                            <td>

                                <span class="total-price">
                                    @(item.Product.Price * item.Quantity)
                                </span>

                              
                            </td>
                            <td>
                                <a href="@Url.Action("RemoveFromCart", "ShoppingCart", new { id = item.CartId })" class="button-action-de">Remove</a>
                            </td>
                        </tr>
                    }

                    <tr class="total-roww">
                        <td colspan="4"><strong>Total:</strong></td>
                        <td><span id="totalAmount">0.00</span></td>
                        <td>
                            <a href="@Url.Action("payment", "Payment")" class="button-chh">
                                Checkout
                                <img src="~/image/r.jpg" alt="Info">
                            </a>
                        </td>
                    </tr>
                </tbody>
           

            </table>

            <a href="@Url.Action("Index", "Interface2")" class="buttonc">
                <img src="~/image/p.jpg" alt="Home"> Continue Shopping
            </a>
        }
        else
        {
            <!-- عرض رسالة عند عدم وجود منتجات -->
            <div class="bodyss">
                <div class="modalss">
                    <p class="messagess"><strong>Your cart is empty... let’s fill it up!<br> Start your shopping journey and pick the products you love.</strong></p> <div class="progress-barss">
                        <div class="progressss"></div>
                    </div> 
                        <div class="buttonsss">
                        <a href="@Url.Action("Index", "Interface2")" class="buttonca">
                            Start Shopping
                        </a>
      
                         </div> 
         </div>
      </div>
        }
    </div>
</div>


