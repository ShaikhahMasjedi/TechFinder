@model TechFinder.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact Us";
}
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}


  @if (ViewBag.Message != null)
{
    <div id="popupMessage">
         @ViewBag.Message
    </div>
}
<section class="section">
    <div class="container3">
        <div class="form-container">
            <div class="left-container">
                <div class="left-inner-container">
                    <h2>Let's Chat</h2><br>
                    <p>If you have any questions or inquiries, feel free to reach out to us.</p>
                    <div class="info">
                        <p>
                            <i class="fa fa-location-dot"></i>
                            <small>Online</small>
                        </p>
                        <p>
                            <i class="fas fa-phone-alt"></i>
                            <small>(+967) 700-972-185</small>
                        </p>
                        <p>
                            <i class="fas fa-envelope"></i>
                            <small>TechFinder@gmail.com</small>
                        </p>
                    </div>
                </div>
            </div>
            <div class="right-container">
                <div class="right-inner-container">
                    <form asp-action="Contactus" asp-controller="Contact" method="post">
                        <h2 class="lg-view">Contact Us</h2>
                        <div class="social-container">
                            <a href="#" class="social"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social"><i class="fab fa-twitter"></i></a>
                            <a href="#" class="social"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social"><i class="fab fa-whatsapp"></i></a>
                        </div>

                        <input asp-for="Name" placeholder="Name *" />
                        <input asp-for="Email" placeholder="Email *" type="email" />
                        <input asp-for="phone" placeholder="Phone" type="tel" />
                        <textarea asp-for="Message" rows="4" placeholder="Message"></textarea>

                        <button type="submit" class="btn custom-send-btn  btn-sm">Send</button>

                    </form>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial,sans-serif; 
            text-decoration: none;
        }
        body {
            background: #eee; 
        }
        .section {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            height: 90vh;
            margin: 3rem;
            margin-bottom:4rem;
            margin-top:135px;
        }
        .container3 {
            background-color: white;
            border-radius: 5px;
            box-shadow: 0 14px 28px rgba(0, 0, 0, 0.25), 
                        0 10px 10px rgba(0, 0, 0, 0.22);
            position: relative;
            width: 900px;
            max-width: 100%;
            height: 560px;
            min-width: 370px;
        }
        .section .social-container {
            display: flex;
            justify-content: center;
        }
        .section .social {
            margin: 1rem;
            font-size: 2rem; 
            color: #001F3F; 
        }

       .section  h2 {
            color: #001F3F;
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        .section .form-container {
            display: flex;
        }

       .section  .right-container {
            display: flex;
            flex: 1;
            height: 600px;
            background-color: white;
            justify-content: center;
            align-items: center;
        }
      .section   .left-container {
            display: flex;
            flex: 1;
            height: 600px;
            justify-content: center;
            align-items: center;
            color: white;
            background-color: #476c7d;
        }
       .section  .left-container p {
            font-size: 1.2rem;
            color: white;
        }
       .section  .info{

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: white;
            border:2px dashed #476c7d;
            margin-top: 70px;
   
        }
       .section  .info  p{
            margin:5px 0px;
            color: #001F3F;
        }
       .section  .right-inner-container {
            width: 70%;
            height: 80%;
            text-align: center;
        }
       .section  .left-inner-container {
            height: 50%;
            width: 80%;
            text-align: center;
            line-height: 22px;
        }
       .section  input, textarea {
            background-color: white;
            border: 1px solid #ccc;
            padding: 12px 15px;
            margin: 6px 0;
            width: 100%;
            font-size: 0.8rem;
        }
      .section   input:focus, textarea:focus {
            outline: 1px solid #001F3F;
        }
        .custom-send-btn {
            border-radius: 20px;
            border: none;
            background-color: #3A6D8C;
            font-size: 18px;
            font-weight: bold;
            padding: 12px 45px;
            color: white;
            margin-top: 8px;
            cursor: pointer;
            outline: none; 
        }
       .custom-send-btn:focus {
        outline: none; 
        box-shadow: none; 
    }
        .custom-send-btn:hover {
            color: white;
            background-color: #6A9AB0;
        }

       .section  .link {
            color: white;
        }
    
         #popupMessage {
        font-size: 1.5rem;
        background-color: #003366;
        color: white;
        padding: 20px 30px;
        border-radius: 10px;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1000;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        text-align: center;
    }
    </style>
}

