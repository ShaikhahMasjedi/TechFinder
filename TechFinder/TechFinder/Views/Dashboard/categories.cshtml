@model IEnumerable<TechFinder.Models.Category>
@{
    ViewData["Title"] = "categories";
}
<script>
    function confirmDelete(CategoryId) {
        if (confirm('Are you sure you want to delete this category?')) {
            document.getElementById('deleteForm-' + CategoryId).submit();
        }
    }
</script>
<div class="createbutton">
    <a asp-action="categoriesadd" class="btn custom-btn-add btn-sm"><i class="fa-solid fa-add"></i> Create New Categories</a>
</div>
<div class="tableContanier">
    <table class="information-table-list table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@Url.Content("~/image/" + item.ImageUrl)" style="width:50px; height:auto;" />
                    </td>
                    <td>@item.Name</td>
                    <td class="btn-col">
                    <a asp-action="CategoryUpdate" asp-route-id="@item.CategoryId" class="btn custom-btn-update btn-sm"><i class="fa-solid fa-pen-to-square"></i> Update</a>
                        <form id="deleteForm-@item.CategoryId" asp-action="CategoryDelete" asp-route-id="@item.CategoryId" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                        <a onclick="confirmDelete(@item.CategoryId)" class="btn custom-btn-del btn-sm">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>